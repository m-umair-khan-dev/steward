# Copy to .env (`make init` does this). Nothing in here is secret.

# Ubuntu release to build and test against. 26.10 for now; 24.04 and 26.04
# are tested once the project is complete (ADR 0007).
UBUNTU_VERSION=26.10

# Parallel compile jobs inside the container. Keep low on machines with little
# memory (Docker Desktop's VM defaults to a few GB).
CARGO_BUILD_JOBS=2

# Which end-to-end tests run by default.
E2E_MARK=not manual

# Headless compositor for tests: mutter or weston (empty = default from ADR 0002).
STEWARD_COMPOSITOR=
