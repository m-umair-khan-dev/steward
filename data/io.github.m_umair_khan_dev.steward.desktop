[Desktop Entry]
Type=Application
Name=Steward
GenericName=File Manager
Comment=Browse your files and keep folders tidy
Keywords=folder;files;manager;explore;disk;tidy;clean;space;
Exec=steward %U
Icon=io.github.m_umair_khan_dev.steward
Terminal=false
StartupNotify=true
StartupWMClass=io.github.m_umair_khan_dev.steward
Categories=System;FileTools;FileManager;Qt;
MimeType=inode/directory;
Actions=new-window;new-workspace;add-link;free-up-space;
X-GNOME-UsesNotifications=false

[Desktop Action new-window]
Name=New Window
Exec=steward --new-window

[Desktop Action new-workspace]
Name=New Workspace
Exec=steward --new-workspace

[Desktop Action add-link]
Name=Add Link
Exec=steward --add-link

[Desktop Action free-up-space]
Name=Free Up Space
Exec=steward --free-up-space
