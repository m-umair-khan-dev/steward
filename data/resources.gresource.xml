<?xml version="1.0" encoding="UTF-8"?>
<gresources>
  <gresource prefix="/dev/cairn/Files">
    <!-- Compiled from data/ui/*.blp into OUT_DIR by build.rs -->
    <file preprocess="xml-stripblanks">ui/window.ui</file>
    <!-- GtkApplication loads this one by itself and adds win.show-help-overlay -->
    <file preprocess="xml-stripblanks" alias="gtk/help-overlay.ui">ui/help-overlay.ui</file>
    <!-- Not at the root: AdwApplication would load a root style.css by itself,
         and debug builds load the file from disk instead (live reload). -->
    <file alias="css/style.css">style.css</file>
    <file alias="css/style-dark.css">style-dark.css</file>
    <file alias="css/accent.css">accent.css</file>
    <file alias="css/accent-dark.css">accent-dark.css</file>
  </gresource>
</gresources>
