# D-Bus activation for Steward (installed to /usr/share/dbus-1/services/): the
# Shell's Activities search starts Steward in the background when it is not
# running (P8-T04). No window opens until a result is chosen.
[D-BUS Service]
Name=io.github.m_umair_khan_dev.steward
Exec=/usr/bin/steward --background
