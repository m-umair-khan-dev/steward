<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="cairn">
  <schema id="dev.cairn.Files" path="/dev/cairn/Files/">
    <key name="default-view" type="s">
      <choices>
        <choice value="grid"/>
        <choice value="list"/>
      </choices>
      <default>'grid'</default>
      <summary>View for folders opened for the first time</summary>
    </key>
    <key name="row-size" type="s">
      <choices>
        <choice value="small"/>
        <choice value="medium"/>
        <choice value="large"/>
      </choices>
      <default>'medium'</default>
      <summary>Size of cards and list rows</summary>
    </key>
    <key name="color-scheme" type="s">
      <choices>
        <choice value="system"/>
        <choice value="light"/>
        <choice value="dark"/>
      </choices>
      <default>'system'</default>
      <summary>Light, dark, or follow the system</summary>
    </key>
    <key name="accent" type="s">
      <choices>
        <choice value="cairn"/>
        <choice value="system"/>
      </choices>
      <default>'cairn'</default>
      <summary>Cairn's purple accent, or the system accent colour</summary>
    </key>
    <key name="show-hidden" type="b">
      <default>false</default>
      <summary>Show hidden files</summary>
    </key>
    <key name="preview-visible" type="b">
      <default>false</default>
      <summary>Show the preview pane</summary>
    </key>
    <key name="sidebar-visible" type="b">
      <default>true</default>
      <summary>Show the sidebar</summary>
    </key>
    <key name="window-width" type="i">
      <default>1100</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>720</default>
      <summary>Window height</summary>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Window maximized</summary>
    </key>
    <key name="dual-pane" type="b">
      <default>false</default>
      <summary>Two panes are open</summary>
    </key>
    <key name="pane-left" type="s">
      <default>''</default>
      <summary>The left pane's folder</summary>
    </key>
    <key name="pane-right" type="s">
      <default>''</default>
      <summary>The right pane's folder</summary>
    </key>
    <key name="downloads-folder" type="s">
      <default>''</default>
      <summary>The folder treated as Downloads</summary>
      <description>Empty means the system's Downloads folder.</description>
    </key>
    <key name="index-roots" type="as">
      <default>[]</default>
      <summary>Folders the search index covers</summary>
      <description>Empty means the home folder.</description>
    </key>
    <key name="index-exclude" type="as">
      <default>[]</default>
      <summary>Folders the search index leaves out</summary>
    </key>
    <key name="index-paused" type="b">
      <default>false</default>
      <summary>Indexing is paused</summary>
    </key>
    <key name="index-pause-on-battery" type="b">
      <default>true</default>
      <summary>Pause indexing while on battery</summary>
    </key>
    <key name="welcome-shown" type="b">
      <default>false</default>
      <summary>The welcome was shown</summary>
      <description>Set when the first-run welcome is finished or skipped (P6-T01).</description>
    </key>
    <key name="last-version" type="s">
      <default>''</default>
      <summary>The last version that ran</summary>
      <description>What's New shows once when the app runs a newer version than this (P6-T02).</description>
    </key>
    <key name="default-file-manager" type="b">
      <default>false</default>
      <summary>Use Cairn as the default file manager</summary>
      <description>Open folders in Cairn and answer other apps' "Show in folder" (org.freedesktop.FileManager1) while Cairn runs (P6-T07).</description>
    </key>
  </schema>
</schemalist>
