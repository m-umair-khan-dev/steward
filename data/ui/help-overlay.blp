using Gtk 4.0;

// Loaded automatically by GtkApplication (resource gtk/help-overlay.ui) and
// opened with win.show-help-overlay (Ctrl+?). Keep in step with the accels
// in src/application.rs and DESIGN.md Appendix A.
ShortcutsWindow help_overlay {
  modal: true;

  ShortcutsSection {
    section-name: "shortcuts";
    max-height: 12;

    ShortcutsGroup {
      title: _("Going Places");

      ShortcutsShortcut {
        title: _("Type a path or a folder name");
        action-name: "win.location";
      }

      ShortcutsShortcut {
        title: _("Filter this folder");
        action-name: "win.filter";
      }

      ShortcutsShortcut {
        title: _("Back");
        action-name: "win.back";
      }

      ShortcutsShortcut {
        title: _("Forward");
        action-name: "win.forward";
      }

      ShortcutsShortcut {
        title: _("Up to the parent folder");
        action-name: "win.up";
      }

      ShortcutsShortcut {
        title: _("Home folder");
        action-name: "win.home";
      }

      ShortcutsShortcut {
        title: _("Reload");
        action-name: "win.reload";
      }
    }

    ShortcutsGroup {
      title: _("View");

      ShortcutsShortcut {
        title: _("Grid");
        action-name: "win.view-mode";
        accelerator: "<Control>1";
      }

      ShortcutsShortcut {
        title: _("List");
        action-name: "win.view-mode";
        accelerator: "<Control>2";
      }

      ShortcutsShortcut {
        title: _("Larger");
        action-name: "win.zoom-in";
      }

      ShortcutsShortcut {
        title: _("Smaller");
        action-name: "win.zoom-out";
      }

      ShortcutsShortcut {
        title: _("Normal size");
        action-name: "win.zoom-reset";
      }

      ShortcutsShortcut {
        title: _("Show hidden files");
        action-name: "win.show-hidden";
      }

      ShortcutsShortcut {
        title: _("Show the sidebar");
        action-name: "win.toggle-sidebar";
      }

      ShortcutsShortcut {
        title: _("Show the preview pane");
        action-name: "win.toggle-preview";
      }
    }

    ShortcutsGroup {
      title: _("General");

      ShortcutsShortcut {
        title: _("Open the selected item");
        action-name: "win.open-selected";
      }

      ShortcutsShortcut {
        title: _("Preferences");
        action-name: "app.preferences";
      }

      ShortcutsShortcut {
        title: _("Keyboard shortcuts");
        action-name: "win.show-help-overlay";
      }

      ShortcutsShortcut {
        title: _("Quit");
        action-name: "app.quit";
      }
    }
  }
}
