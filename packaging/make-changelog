#!/usr/bin/env python3
"""Writes debian/changelog from the release notes (site/src/content/changelog),
newest first: the same file feeds the site's changelog and What's New.

    make-changelog UBUNTU_RELEASE > changelog
"""

import re
import sys
from datetime import datetime, timezone
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
MAINTAINER = "Steward contributors <maintainers@example.invalid>"


def notes() -> list[dict]:
    out = []
    for path in (REPO / "site/src/content/changelog").glob("*.md"):
        text = path.read_text()
        front, body = text.split("---", 2)[1:]
        meta = dict(line.split(": ", 1) for line in front.strip().splitlines() if ": " in line)
        items = [re.sub(r"\*\*(.*?)\*\*", r"\1", line[2:]) for line in body.splitlines() if line.startswith("- ")]
        out.append({"version": meta["version"], "date": meta["date"], "items": items})
    out.sort(key=lambda n: [int(p) for p in re.findall(r"\d+", n["version"])], reverse=True)
    return out


def wrap(text: str, width: int = 74) -> list[str]:
    lines, line = [], ""
    for word in text.split():
        if line and len(line) + 1 + len(word) > width:
            lines.append(line)
            line = word
        else:
            line = f"{line} {word}".strip()
    return lines + [line] if line else lines


def main() -> None:
    release = sys.argv[1]
    for note in notes():
        when = datetime.fromisoformat(note["date"]).replace(hour=12, tzinfo=timezone.utc)
        print(f"steward ({note['version']}-1~ubuntu{release}) stable; urgency=medium\n")
        for item in note["items"]:
            first, *rest = wrap(item)
            print(f"  * {first}")
            for line in rest:
                print(f"    {line}")
        print(f"\n -- {MAINTAINER}  {when.strftime('%a, %d %b %Y %H:%M:%S %z')}\n")


if __name__ == "__main__":
    main()
