#!/usr/bin/env python3
"""Translations (P6-T04): extract messages, check catalogs, make the pseudo-locale.

    i18n extract     write po/steward.pot from the sources
    i18n update      merge po/steward.pot into every po/<lang>.po (msgmerge)
    i18n check       every catalog translates every message (exit 1 if not)
    i18n pseudo      write po/en@pseudo.po: every message longer and accented

Sources: gettext("…") and ngettext("…", "…") in crates/app/src, p.t("…") in
crates/app/qml, the kind and section names in steward-core, the shortcut
descriptions in actions.rs, and the names and reasons in data/clean.
"""

import re
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
PO = REPO / "po"
POT = PO / "steward.pot"
STRING = r'"((?:[^"\\]|\\.)*)"'


PLURALS: dict[str, str] = {}


def messages() -> dict[str, list[str]]:
    """Every message and where it is used. Plural pairs (ngettext) are keyed
    by the singular; PLURALS maps it to the plural."""
    found: dict[str, list[str]] = {}

    def add(text: str, where: str) -> None:
        if text and re.search(r"[A-Za-z]", text):
            found.setdefault(text, []).append(where)

    for path in sorted((REPO / "crates/app/src").rglob("*.rs")):
        rel = path.relative_to(REPO).as_posix()
        source = path.read_text()
        for m in re.finditer(r"\b(n?)gettext\(\s*" + STRING + r"(?:\s*,\s*" + STRING + r")?", source):
            line = source.count("\n", 0, m.start()) + 1
            add(m.group(2), f"{rel}:{line}")
            if m.group(1) and m.group(3):
                PLURALS[m.group(2)] = m.group(3)
        # unit(n, "day", "days") in about.rs
        for m in re.finditer(r"unit\([^,]+,\s*" + STRING + r",\s*" + STRING, source):
            line = source.count("\n", 0, m.start()) + 1
            add(m.group(1), f"{rel}:{line}")
            add(m.group(2), f"{rel}:{line}")
        if path.name == "actions.rs":
            for m in re.finditer(r'\("(?:app|win)\.[^"]+",\s*"[^"]*",\s*&\[[^\]]*\],\s*' + STRING + r"\s*,?\s*\)", source):
                add(m.group(1), f"{rel}:{source.count(chr(10), 0, m.start()) + 1}")
    for path in sorted((REPO / "crates/app/qml").glob("*.qml")):
        rel = path.relative_to(REPO).as_posix()
        source = path.read_text()
        for m in re.finditer(r"\bp\.t\(\s*" + STRING + r"\s*\)", source):
            add(m.group(1), f"{rel}:{source.count(chr(10), 0, m.start()) + 1}")
    kind = (REPO / "crates/core/src/kind.rs").read_text()
    label_fn = kind[kind.index("pub fn label"):]
    label_fn = label_fn[:label_fn.index("\n    }\n")]
    for m in re.finditer(r"=>\s*" + STRING, label_fn):
        add(m.group(1), "crates/core/src/kind.rs")
    sort = (REPO / "crates/core/src/sort.rs").read_text()
    for m in re.finditer(r"label:\s*" + STRING, sort):
        add(m.group(1), "crates/core/src/sort.rs")
    clean = (REPO / "data/clean/dev-caches.toml").read_text()
    for m in re.finditer(r"^(?:name|reason)\s*=\s*" + STRING, clean, re.M):
        add(m.group(1), "data/clean/dev-caches.toml")
    return found


def quote(text: str) -> str:
    return '"' + text + '"'


def extract() -> None:
    found = messages()
    out = [
        "# Steward's messages. Generated by docker/scripts/i18n extract; do not edit.",
        "# This file is distributed under the same licence as Steward.",
        "#, fuzzy",
        'msgid ""',
        'msgstr ""',
        '"Project-Id-Version: steward\\n"',
        '"MIME-Version: 1.0\\n"',
        '"Content-Type: text/plain; charset=UTF-8\\n"',
        '"Content-Transfer-Encoding: 8bit\\n"',
        "",
    ]
    for text in sorted(found):
        out.append("#: " + " ".join(sorted(set(found[text]))[:4]))
        out.append("msgid " + quote(text))
        if text in PLURALS:
            out += ["msgid_plural " + quote(PLURALS[text]), 'msgstr[0] ""', 'msgstr[1] ""']
        else:
            out.append('msgstr ""')
        out.append("")
    POT.write_text("\n".join(out))
    print(f"{POT.relative_to(REPO)}: {len(found)} messages")


def catalogs() -> list[Path]:
    return sorted(p for p in PO.glob("*.po") if p.stem != "en@pseudo")


def update() -> None:
    for po in catalogs():
        subprocess.run(["msgmerge", "--quiet", "--update", "--backup=none", "--no-fuzzy-matching", "--no-wrap",
                        str(po), str(POT)], check=True)
        # One line per string, so diffs stay readable.
        subprocess.run(["msgcat", "--no-wrap", "-o", str(po), str(po)], check=True)
        print(f"updated {po.name}")


def parse_po(path: Path) -> dict[str, str]:
    entries: dict[str, str] = {}
    msgid = msgstr = None
    key = None
    fuzzy = False
    obsolete = False

    def flush() -> None:
        if msgid is not None and not obsolete:
            entries[msgid] = "" if fuzzy and msgid else (msgstr or "")

    for line in path.read_text().splitlines() + [""]:
        if line.startswith("#~"):
            obsolete = True
            continue
        if line.startswith("#,") and "fuzzy" in line:
            fuzzy = True
        elif line.startswith("msgid "):
            msgid, key = eval(line[6:]), "id"  # noqa: S307 (po strings are C strings)
        elif line.startswith("msgid_plural "):
            key = "plural"
        elif line.startswith("msgstr[0] ") or line.startswith("msgstr "):
            msgstr, key = eval(line.split(" ", 1)[1]), "str"  # noqa: S307
        elif line.startswith("msgstr["):
            key = "other"
        elif line.startswith('"'):
            if key == "id":
                msgid += eval(line)  # noqa: S307
            elif key == "str":
                msgstr += eval(line)  # noqa: S307
        elif not line.strip():
            flush()
            msgid = msgstr = key = None
            fuzzy = obsolete = False
    return entries


def check() -> int:
    wanted = set(messages())
    problems = 0
    for po in catalogs():
        have = parse_po(po)
        missing = sorted(t for t in wanted if not have.get(t))
        for text in missing[:10]:
            print(f"{po.name}: not translated: {text!r}")
        if missing:
            print(f"{po.name}: {len(missing)} of {len(wanted)} messages not translated")
            problems += 1
        else:
            print(f"{po.name}: all {len(wanted)} messages translated")
    return 1 if problems else 0


ACCENTS = str.maketrans("aceinouyACEINOUY", "àçéîñöüýÀÇÉÎÑÖÜÝ")


def pseudo_text(text: str) -> str:
    """Accented and a third longer, with placeholders, markup and keys kept."""
    parts = re.split(r"(<[^>]*>|&\w+;|\{[^}]*\}|%\w|Ctrl\+\S+|F\d+)", text)
    body = "".join(p if i % 2 else p.translate(ACCENTS) for i, p in enumerate(parts))
    pad = "~" * max(2, len(text) // 3)
    return f"[{body} {pad}]"


def pseudo() -> None:
    out = ["# Generated by docker/scripts/i18n pseudo: long, accented English for",
           "# finding cut-off text and strings that skip translation. Do not edit.",
           'msgid ""', 'msgstr ""', '"Content-Type: text/plain; charset=UTF-8\\n"',
           '"Language: en@pseudo\\n"', '"Plural-Forms: nplurals=2; plural=(n != 1);\\n"', ""]
    for text in sorted(messages()):
        if text in PLURALS:
            out += ["msgid " + quote(text), "msgid_plural " + quote(PLURALS[text]),
                    "msgstr[0] " + quote(pseudo_text(text)),
                    "msgstr[1] " + quote(pseudo_text(PLURALS[text])), ""]
        else:
            out += ["msgid " + quote(text), "msgstr " + quote(pseudo_text(text)), ""]
    (PO / "en@pseudo.po").write_text("\n".join(out))
    print("po/en@pseudo.po written")


if __name__ == "__main__":
    command = sys.argv[1] if len(sys.argv) > 1 else "extract"
    if command == "extract":
        extract()
    elif command == "update":
        update()
    elif command == "check":
        sys.exit(check())
    elif command == "pseudo":
        pseudo()
    else:
        sys.exit(__doc__)
