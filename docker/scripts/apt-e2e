#!/bin/bash
# `make apt-e2e` (E6-06), on the host: publish the .deb to a throwaway "ci"
# suite, install it with apt in a clean Ubuntu, publish a higher version,
# and upgrade. Needs dist/<release>/*.deb (make deb) and the dev key
# (make keys). Uses its own Compose project, removed at the end.
set -euo pipefail
cd "$(dirname "$0")/../.."
release="${UBUNTU_VERSION:?}"
export APT_SUITE=ci COMPOSE_PROJECT_NAME=steward-apt-e2e
compose=(docker compose -f compose.yaml -f compose.test.yaml)
deb="$(ls dist/"$release"/steward_*.deb | head -1)"
[ -n "$deb" ] || { echo "apt-e2e: no .deb in dist/$release (make deb)" >&2; exit 1; }
v1="$(dpkg-deb -f "$deb" Version 2>/dev/null || docker run --rm -v "$PWD/dist:/d:ro" "${UBUNTU_IMAGE}" dpkg-deb -f "/d/$release/$(basename "$deb")" Version)"
v2="${v1%%-*}.1-1~ubuntu${release}"
cleanup() { "${compose[@]}" --profile publish down -v --remove-orphans >/dev/null 2>&1 || true; rm -rf target/apt-e2e; }
trap cleanup EXIT
cleanup

echo "== publish $v1 to ci-$release"
"${compose[@]}" --profile publish run --rm aptrepo
"${compose[@]}" up -d --wait apt-web
echo "== install with apt"
"${compose[@]}" up -d apt-client
"${compose[@]}" exec -T apt-client /scripts/apt-install-e2e install "$v1"

echo "== publish $v2 and upgrade"
mkdir -p "target/apt-e2e/$release"
"${compose[@]}" --profile publish run --rm --entrypoint deb-bump -v "$PWD/target/apt-e2e:/out" \
  aptrepo "/in/$release/$(basename "$deb")" "$v2" "/out/$release/steward_${v2}_amd64.deb"
APT_IN=./target/apt-e2e "${compose[@]}" --profile publish run --rm aptrepo
"${compose[@]}" exec -T apt-client /scripts/apt-install-e2e upgrade "$v2"
echo "apt-e2e: install and upgrade work on $release"
