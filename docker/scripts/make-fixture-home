#!/usr/bin/env python3
"""Builds Steward's fixture home: a deterministic fake home folder (DESIGN.md §9.4).

The app runs against this folder in development and tests, never against a real
home. The marker file `.steward-fixture` at its root holds the manifest: a JSON
description of what was planted (counts, sizes, duplicates, what Tidy should
move), so tests can assert against known facts.

Same recipe version in, byte-identical tree out: fixed contents, fixed times,
fixed permissions, and no compression whose output could vary between zlib
builds. Large files are sparse, so "gigabytes" cost no disk.

    make-fixture-home DEST [--force]     build the fixture home in DEST
    make-fixture-home --digest DIR       print a digest of a built tree

All names and contents here are invented for this project (AGENTS.md rule 12).
"""

from __future__ import annotations

import argparse
import base64
import hashlib
import io
import json
import os
import re
import shutil
import struct
import sys
import tarfile
import zipfile
import zlib
from datetime import datetime, timezone
from pathlib import Path

RECIPE_VERSION = 4
MARKER = ".steward-fixture"
NOW = int(datetime(2026, 11, 1, 12, 0, 0, tzinfo=timezone.utc).timestamp())
DAY = 86_400
MIB = 1024 * 1024
GIB = 1024 * MIB
SKELETON_FILES = {".bashrc", ".profile", ".bash_logout"}

# Kind of a file by extension. Phase 1 builds the app's kind table from MIME
# types; it must agree with this mapping for every file planted here.
KINDS = {
    "Images": {"png", "jpg", "jpeg", "gif", "webp", "svg"},
    "Videos": {"mp4", "webm", "mov", "mkv"},
    "PDFs": {"pdf"},
    "Documents": {"odt", "ods", "docx", "txt", "md", "csv"},
    "Archives": {"zip", "tar", "gz", "xz"},
    "Installers": {"deb", "rpm", "flatpakref"},
    "Code": {"rs", "js", "py", "json", "toml"},
}
PARTIAL_SUFFIXES = (".crdownload", ".part", ".partial", ".download")

TINY_JPEG = base64.b64decode(
    "/9j/4AAQSkZJRgABAgAAAQABAAD/2wBDAAgQEBMQExYWFhYWFhoYGhsbGxoaGhobGxsdHR0iIiIdHR0bGx0d"
    "ICAiIiUmJSMjIiMmJigoKDAwLi44ODpFRVP/xABMAAEBAAAAAAAAAAAAAAAAAAAABQEBAQAAAAAAAAAAAAAA"
    "AAAABQYQAQAAAAAAAAAAAAAAAAAAAAARAQAAAAAAAAAAAAAAAAAAAAD/wAARCAAQABADASIAAhEAAxEA/9oA"
    "DAMBAAIRAxEAPwCIApAD/9k="
)


def kind_of(name: str) -> str:
    ext = name.rsplit(".", 1)[-1].lower() if "." in name else ""
    for kind, exts in KINDS.items():
        if ext in exts:
            return kind
    return "Other"


# ---------------------------------------------------------------- contents ---


def png(width: int, height: int, seed: int) -> bytes:
    """A real RGB PNG with a seed-dependent gradient, stored without compression."""
    rows = bytearray()
    for y in range(height):
        rows.append(0)  # filter: none
        for x in range(width):
            rows += bytes(((x * 7 + seed * 31) % 256, (y * 5 + seed * 17) % 256, (seed * 53) % 256))

    def chunk(kind: bytes, data: bytes) -> bytes:
        return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data))

    header = struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)
    return (
        b"\x89PNG\r\n\x1a\n"
        + chunk(b"IHDR", header)
        + chunk(b"IDAT", zlib.compress(bytes(rows), 0))
        + chunk(b"IEND", b"")
    )


def jpeg(tag: str) -> bytes:
    """A real 16x16 JPEG made unique by a comment segment."""
    comment = tag.encode()
    segment = b"\xff\xfe" + struct.pack(">H", len(comment) + 2) + comment
    return TINY_JPEG[:2] + segment + TINY_JPEG[2:]


def pdf(*lines: str) -> bytes:
    """A small valid PDF whose text can be extracted."""
    text = "BT /F1 12 Tf 72 720 Td 14 TL " + " ".join(
        "(" + line.replace("\\", "\\\\").replace("(", "\\(").replace(")", "\\)") + ") '"
        for line in lines
    ) + " ET"
    objects = [
        b"<< /Type /Catalog /Pages 2 0 R >>",
        b"<< /Type /Pages /Kids [3 0 R] /Count 1 >>",
        b"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] "
        b"/Contents 4 0 R /Resources << /Font << /F1 5 0 R >> >> >>",
        b"<< /Length " + str(len(text)).encode() + b" >>\nstream\n" + text.encode() + b"\nendstream",
        b"<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>",
    ]
    out = bytearray(b"%PDF-1.4\n")
    offsets = []
    for number, body in enumerate(objects, start=1):
        offsets.append(len(out))
        out += f"{number} 0 obj\n".encode() + body + b"\nendobj\n"
    xref = len(out)
    out += f"xref\n0 {len(objects) + 1}\n0000000000 65535 f \n".encode()
    for offset in offsets:
        out += f"{offset:010d} 00000 n \n".encode()
    out += f"trailer\n<< /Size {len(objects) + 1} /Root 1 0 R >>\nstartxref\n{xref}\n%%EOF\n".encode()
    return bytes(out)


def stored_zip(members: list[tuple[str, bytes]]) -> bytes:
    """A zip with fixed timestamps and no compression (deterministic everywhere)."""
    buffer = io.BytesIO()
    with zipfile.ZipFile(buffer, "w", compression=zipfile.ZIP_STORED) as archive:
        for name, data in members:
            info = zipfile.ZipInfo(name, date_time=(2026, 1, 1, 0, 0, 0))
            info.external_attr = 0o644 << 16
            info.create_system = 3
            archive.writestr(info, data)
    return buffer.getvalue()


def odf(mimetype: str, text: str) -> bytes:
    body = (
        '<?xml version="1.0" encoding="UTF-8"?>'
        '<office:document-content xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" '
        'xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" office:version="1.3">'
        f"<office:body><office:text><text:p>{text}</text:p></office:text></office:body>"
        "</office:document-content>"
    )
    manifest = (
        '<?xml version="1.0" encoding="UTF-8"?>'
        '<manifest:manifest xmlns:manifest="urn:oasis:names:tc:opendocument:xmlns:manifest:1.0" '
        'manifest:version="1.3">'
        f'<manifest:file-entry manifest:full-path="/" manifest:media-type="{mimetype}"/>'
        '<manifest:file-entry manifest:full-path="content.xml" manifest:media-type="text/xml"/>'
        "</manifest:manifest>"
    )
    return stored_zip(
        [("mimetype", mimetype.encode()), ("META-INF/manifest.xml", manifest.encode()),
         ("content.xml", body.encode())]
    )


def odt(text: str) -> bytes:
    return odf("application/vnd.oasis.opendocument.text", text)


def ods(text: str) -> bytes:
    return odf("application/vnd.oasis.opendocument.spreadsheet", text)


def docx(text: str) -> bytes:
    content_types = (
        '<?xml version="1.0" encoding="UTF-8"?>'
        '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">'
        '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>'
        '<Default Extension="xml" ContentType="application/xml"/>'
        '<Override PartName="/word/document.xml" '
        'ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"/>'
        "</Types>"
    )
    rels = (
        '<?xml version="1.0" encoding="UTF-8"?>'
        '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
        '<Relationship Id="rId1" '
        'Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" '
        'Target="word/document.xml"/></Relationships>'
    )
    document = (
        '<?xml version="1.0" encoding="UTF-8"?>'
        '<w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">'
        f"<w:body><w:p><w:r><w:t>{text}</w:t></w:r></w:p></w:body></w:document>"
    )
    return stored_zip(
        [("[Content_Types].xml", content_types.encode()), ("_rels/.rels", rels.encode()),
         ("word/document.xml", document.encode())]
    )


def _tar(members: list[tuple[str, bytes]]) -> bytes:
    buffer = io.BytesIO()
    with tarfile.open(fileobj=buffer, mode="w", format=tarfile.GNU_FORMAT) as archive:
        for name, data in members:
            info = tarfile.TarInfo(name)
            info.size, info.mtime, info.mode = len(data), NOW - 400 * DAY, 0o644
            info.uid = info.gid = 0
            info.uname = info.gname = "root"
            archive.addfile(info, io.BytesIO(data))
    return buffer.getvalue()


def deb(package: str, version: str, description: str) -> bytes:
    """A minimal real .deb (uncompressed members) that dpkg-deb can read."""
    control = (
        f"Package: {package}\nVersion: {version}\nArchitecture: amd64\n"
        f"Maintainer: Fixture <fixture@example.invalid>\nDescription: {description}\n"
    ).encode()
    members = [
        ("debian-binary", b"2.0\n"),
        ("control.tar", _tar([("./control", control)])),
        ("data.tar", _tar([])),
    ]
    out = bytearray(b"!<arch>\n")
    for name, data in members:
        header = f"{name + '/':<16}{NOW - 400 * DAY:<12}{0:<6}{0:<6}{'100644':<8}{len(data):<10}`\n"
        out += header.encode() + data
        if len(data) % 2:
            out += b"\n"
    return bytes(out)


def text(*lines: str) -> bytes:
    return ("\n".join(lines) + "\n").encode()


# AI Agents (E7-04, ADR 0013): Claude Code logs and settings, and agent files
# for three projects. Paths are written "~/…" so the fixture can be copied
# anywhere (Steward reads both that and absolute paths).
WEB_CLAUDE_MD = text("# web-app", "", "Run `npm test` before committing.")
WEB_MCP_JSON = text('{ "mcpServers": { "github": { "command": "github-mcp" }, '
                    '"postgres": { "command": "pg-mcp", "args": ["--read-only"] } } }')
AGENT_SESSIONS = {
    # project: [(day offset from NOW, message id, input, output, cache write, cache read)]
    "Documents/Projects/web-app": [(-1, "msg_a1", 1200, 400, 8000, 0), (-1, "msg_a2", 900, 300, 0, 9000),
                                   (-3, "msg_a3", 2000, 800, 4000, 12000)],
    "Documents/Projects/api": [(-2, "msg_b1", 500, 150, 3000, 0)],
}
AGENT_PROJECTS = {
    "Documents/Projects/web-app": {"tools": ["claude"], "files": ["CLAUDE.md", ".mcp.json"],
                                   "servers": ["github", "postgres", "playwright"]},
    "Documents/Projects/api": {"tools": ["claude", "codex", "cursor"], "files": ["AGENTS.md", ".cursor/rules"],
                               "servers": []},
    "Documents/Projects/old-site": {"tools": ["cursor"], "files": [".cursorrules"], "servers": []},
}


def plant_agents(b: "Builder") -> None:
    web, api, old = "Documents/Projects/web-app", "Documents/Projects/api", "Documents/Projects/old-site"
    b.file(f"{web}/CLAUDE.md", WEB_CLAUDE_MD, 6)
    b.file(f"{web}/.mcp.json", WEB_MCP_JSON, 6)
    b.file(f"{api}/AGENTS.md", text("# api", "", "cargo test must pass."), 10)
    b.file(f"{api}/.cursor/rules/style.md", text("Prefer small functions."), 10)
    b.file(f"{old}/.cursorrules", text("Use tabs."), 250)
    b.file(".claude.json", text(json.dumps({
        "numStartups": 3,
        "mcpServers": {"docs": {"type": "http", "url": "http://localhost:9000/mcp"}},
        "projects": {f"~/{web}": {"mcpServers": {"playwright": {"command": "npx", "args": ["@playwright/mcp"]}}},
                     f"~/{api}": {"mcpServers": {}}},
    }, indent=2, sort_keys=True)), 2)
    for project, turns in AGENT_SESSIONS.items():
        lines = [json.dumps({"type": "user", "cwd": f"~/{project}", "timestamp": iso(NOW + turns[0][0] * DAY),
                             "message": {"role": "user", "content": "(planted)"}})]
        for offset, mid, i, o, cw, cr in turns:
            usage = {"input_tokens": i, "output_tokens": o, "cache_creation_input_tokens": cw,
                     "cache_read_input_tokens": cr}
            lines.append(json.dumps({"type": "assistant", "cwd": f"~/{project}", "timestamp": iso(NOW + offset * DAY),
                                     "message": {"id": mid, "usage": usage}}))
        folder = "-home-dev-" + project.replace("/", "-")
        b.file(f".claude/projects/{folder}/session-1.jsonl", ("\n".join(lines) + "\n").encode(), 1)


def iso(seconds: float) -> str:
    return datetime.fromtimestamp(seconds, timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.000Z")


def agents_manifest() -> dict:
    projects = {}
    days: dict[str, int] = {}
    for rel, facts in AGENT_PROJECTS.items():
        turns = AGENT_SESSIONS.get(rel, [])
        total = sum(i + o + cw + cr for _, _, i, o, cw, cr in turns)
        for offset, _, i, o, cw, cr in turns:
            day = iso(NOW + offset * DAY)[:10]
            days[day] = days.get(day, 0) + i + o + cw + cr
        projects[rel] = dict(facts, sessions=1 if turns else 0, tokens=total)
    return {"projects": projects, "user_servers": ["docs"], "days": days,
            "tokens_total": sum(days.values())}


def git_repo(b: "Builder", rel: str, committed: dict[str, bytes], branch: str, age_days: float) -> None:
    """Writes a Git repository for `rel` with one commit of `committed`.

    Written by hand, not with git, so the tree is byte-identical on every
    build: objects are zlib "stored" (level 0, the same on every zlib), and
    the index has no timestamps, inodes or devices (Git then compares
    contents, which is what a fresh clone does too)."""
    git = f"{rel}/.git"
    when = NOW - int(age_days * DAY)

    def obj(kind: str, data: bytes) -> bytes:
        raw = f"{kind} {len(data)}".encode() + b"\0" + data
        sha = hashlib.sha1(raw).digest()
        hex_ = sha.hex()
        b.file(f"{git}/objects/{hex_[:2]}/{hex_[2:]}", zlib.compress(raw, 0), age_days, mode=0o444)
        return sha

    blobs = {path: obj("blob", data) for path, data in committed.items()}

    def tree(prefix: str) -> bytes:
        names: dict[str, bytes | None] = {}
        for path in blobs:
            if path.startswith(prefix):
                head, _, rest = path[len(prefix):].partition("/")
                names[head] = None if rest else blobs[path]
        entries = []
        for name in names:
            if names[name] is None:
                entries.append((name + "/", b"40000 " + name.encode() + b"\0" + tree(prefix + name + "/")))
            else:
                entries.append((name, b"100644 " + name.encode() + b"\0" + names[name]))
        return obj("tree", b"".join(e for _, e in sorted(entries)))

    root = tree("")
    person = f"Fixture <fixture@example.invalid> {when} +0000"
    commit = obj("commit", f"tree {root.hex()}\nauthor {person}\ncommitter {person}\n\nFirst version\n".encode())

    index = bytearray(b"DIRC" + struct.pack(">II", 2, len(blobs)))
    for path in sorted(blobs, key=lambda p: p.encode()):
        name = path.encode()
        entry = struct.pack(">10I", 0, 0, 0, 0, 0, 0, 0o100644, 0, 0, len(committed[path]))
        entry += blobs[path] + struct.pack(">H", min(len(name), 0xFFF)) + name
        entry += b"\0" * (8 - (len(entry) % 8))
        index += entry
    index += hashlib.sha1(bytes(index)).digest()

    b.file(f"{git}/HEAD", f"ref: refs/heads/{branch}\n".encode(), age_days)
    b.file(f"{git}/refs/heads/{branch}", (commit.hex() + "\n").encode(), age_days)
    b.file(f"{git}/index", bytes(index), age_days)
    b.file(f"{git}/config", text("[core]", "\trepositoryformatversion = 0", "\tfilemode = true",
                                 "\tbare = false", "\tlogallrefupdates = false"), age_days)


# ----------------------------------------------------------------- builder ---


class Builder:
    def __init__(self, root: Path) -> None:
        self.root = root
        self.files: dict[str, dict] = {}
        self.dir_age: dict[str, float] = {}
        self.links: dict[str, str] = {}

    def _path(self, rel: str) -> Path:
        path = self.root / rel
        path.parent.mkdir(parents=True, exist_ok=True)
        return path

    def _record(self, rel: str, size: int, age_days: float, atime_days: float | None, sparse: bool):
        self.files[rel] = {"size": size, "age_days": age_days, "sparse": sparse,
                           "atime_days": age_days if atime_days is None else atime_days}

    def file(self, rel: str, data: bytes, age_days: float, atime_days: float | None = None,
             mode: int = 0o644) -> None:
        path = self._path(rel)
        path.write_bytes(data)
        os.chmod(path, mode)
        self._record(rel, len(data), age_days, atime_days, sparse=False)

    def sparse(self, rel: str, size: int, header: bytes, age_days: float,
               atime_days: float | None = None, mode: int = 0o644) -> None:
        path = self._path(rel)
        with open(path, "wb") as handle:
            handle.write(header)
            handle.truncate(size)
        os.chmod(path, mode)
        self._record(rel, size, age_days, atime_days, sparse=True)

    def link(self, rel: str, target: str) -> None:
        path = self._path(rel)
        os.symlink(target, path)
        self.links[rel] = target

    def dir(self, rel: str, age_days: float = 1) -> None:
        (self.root / rel).mkdir(parents=True, exist_ok=True)
        self.dir_age[rel] = age_days

    def finish(self, manifest: dict) -> None:
        marker = self.root / MARKER
        marker.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
        os.chmod(marker, 0o644)
        os.utime(marker, ns=(NOW * 10**9, NOW * 10**9))
        for rel, info in self.files.items():
            mtime = int((NOW - info["age_days"] * DAY) * 10**9)
            atime = int((NOW - info["atime_days"] * DAY) * 10**9)
            os.utime(self.root / rel, ns=(atime, mtime))
        for rel in self.links:
            stamp = int((NOW - 20 * DAY) * 10**9)
            os.utime(self.root / rel, ns=(stamp, stamp), follow_symlinks=False)
        # Directories last, deepest first, so setting children's times does not
        # disturb their parents'.
        dirs = sorted((p for p in self.root.rglob("*") if p.is_dir() and not p.is_symlink()),
                      key=lambda p: len(p.parts), reverse=True)
        for path in dirs + [self.root]:
            rel = path.relative_to(self.root).as_posix() if path != self.root else ""
            os.chmod(path, 0o755 if not rel.startswith(".cache") else 0o700)
            stamp = int((NOW - self.dir_age.get(rel, 1) * DAY) * 10**9)
            os.utime(path, ns=(stamp, stamp))


# ------------------------------------------------------------------ recipe ---

MP4_HEADER = b"\x00\x00\x00\x18ftypmp42\x00\x00\x00\x00mp42isom"
WEBM_HEADER = b"\x1a\x45\xdf\xa3\x9f\x42\x86\x81\x01"
ELF_HEADER = b"\x7fELF\x02\x01\x01" + b"\x00" * 9
ISO_HEADER = b"\x00" * 32769 + b"CD001"
INVOICE_0923 = pdf("Invoice 0923", "Northwind Studio", "Total due: 1,250.00")
LOGO = png(48, 48, seed=7)


def build(root: Path) -> dict:
    b = Builder(root)
    for folder in ("Desktop", "Documents", "Downloads", "Music", "Pictures", "Public",
                   "Templates", "Videos"):
        b.dir(folder, age_days=300)
    b.file(".config/user-dirs.dirs", text(*(
        f'XDG_{key}_DIR="$HOME/{value}"' for key, value in (
            ("DESKTOP", "Desktop"), ("DOCUMENTS", "Documents"), ("DOWNLOAD", "Downloads"),
            ("MUSIC", "Music"), ("PICTURES", "Pictures"), ("PUBLICSHARE", "Public"),
            ("TEMPLATES", "Templates"), ("VIDEOS", "Videos")))), age_days=300)
    b.dir(".local/share", age_days=300)

    # --- Downloads: loose files of every kind, duplicates, partial downloads.
    d = "Downloads"
    b.file(f"{d}/beach-sunset.jpg", jpeg("beach-sunset"), 12)
    b.file(f"{d}/mountains.jpg", jpeg("mountains"), 40, atime_days=40)
    b.file(f"{d}/wallpaper-4k.png", png(64, 36, seed=3), 3)
    b.file(f"{d}/logo-final.png", LOGO, 20)
    b.file(f"{d}/logo-final (1).png", LOGO, 19)
    b.file(f"{d}/Screenshot from 2026-10-14 09-12-41.png", png(40, 30, seed=11), 18)
    b.file(f"{d}/Invoice-0923.pdf", INVOICE_0923, 45)
    b.file(f"{d}/Invoice-0923 (1).pdf", INVOICE_0923, 44)
    b.file(f"{d}/Statement-0923.pdf", pdf("Statement September", "Account ending 4417"), 30)
    b.file(f"{d}/Boarding-pass.pdf", pdf("Boarding pass", "Gate 22"), 8)
    b.file(f"{d}/Lease-agreement.pdf", pdf("Lease agreement", "Flat 3B"), 200, atime_days=200)
    b.file(f"{d}/Resume-2026.pdf", pdf("Resume", "Sam Example"), 120, atime_days=120)
    b.file(f"{d}/Meeting-notes.docx", docx("Meeting notes: launch review"), 15)
    b.file(f"{d}/Budget-Q4.ods", ods("Budget Q4"), 22)
    b.file(f"{d}/notes.txt", text("Pick up the parcel", "Call the bank"), 5)
    b.file(f"{d}/todo.md", text("# To do", "", "- [ ] Tidy Downloads"), 2)
    b.file(f"{d}/export.csv", text("date,amount", "2026-08-01,12.50"), 60)
    b.sparse(f"{d}/team-offsite.mp4", 312 * MIB, MP4_HEADER, 25)
    b.sparse(f"{d}/holiday-video.mp4", 1229 * MIB, MP4_HEADER, 150, atime_days=150)
    b.file(f"{d}/photos-export.zip", stored_zip([("a.txt", b"a"), ("b.txt", b"b")]), 33)
    b.file(f"{d}/fonts.zip", stored_zip([("font-readme.txt", b"fonts")]), 95, atime_days=95)
    b.file(f"{d}/photo-tool_3.2.0_amd64.deb", deb("photo-tool", "3.2.0", "Photo tool"), 10)
    b.sparse(f"{d}/Editor-1.4-x86_64.AppImage", 90 * MIB, ELF_HEADER, 70, mode=0o755)
    b.sparse(f"{d}/distro-26.04-desktop-amd64.iso", 6 * GIB, ISO_HEADER, 180, atime_days=180)
    b.sparse(f"{d}/Unconfirmed 418235.crdownload", 48 * MIB, b"", 0.01)
    b.sparse(f"{d}/trip-edit.mp4.part", 210 * MIB, MP4_HEADER, 0.01)
    for name in ("old-notes-1.txt", "old-notes-2.txt", "old-notes-3.txt"):
        b.file(f"{d}/archive/{name}", text(name), 260, atime_days=260)
    for n, month in enumerate(("July", "August", "September"), start=1):
        b.file(f"{d}/Receipts/receipt-{month.lower()}.pdf", pdf(f"Receipt {month}"), 30 * n)
    for n in range(4):
        b.file(f"{d}/Wallpapers/wallpaper-{n + 1}.png", png(32, 18, seed=40 + n), 90)

    # --- Documents: folders that trigger each folder-symbol rule (DESIGN.md §4.1).
    doc = "Documents"
    b.file(f"{doc}/Invoices/Invoice-0923.pdf", INVOICE_0923, 46)
    b.file(f"{doc}/Invoices/Invoice-0812.pdf", pdf("Invoice 0812"), 80)
    b.file(f"{doc}/Invoices/Invoice-0701.pdf", pdf("Invoice 0701"), 120)
    b.file(f"{doc}/Taxes 2026/return-2025.pdf", pdf("Tax return 2025"), 150)
    b.file(f"{doc}/Taxes 2026/receipts.ods", ods("Receipts"), 140)
    b.file(f"{doc}/School/essay.odt", odt("An essay about rivers"), 60)
    b.file(f"{doc}/Travel Japan/itinerary.odt", odt("Day 1: Kyoto"), 50)
    b.file(f"{doc}/Travel Japan/tickets.pdf", pdf("Train tickets"), 50)
    b.file(f"{doc}/Clients/Acme/brief.pdf", pdf("Acme rebrand brief"), 35)
    b.file(f"{doc}/Clients/Acme/contract.docx", docx("Contract"), 34)
    b.file(f"{doc}/Clients/Northwind/Invoices/Invoice-N-014.pdf", pdf("Invoice N-014"), 20)
    for n in range(4):
        b.file(f"{doc}/Manuals/manual-{n + 1}.pdf", pdf(f"Manual {n + 1}"), 300)
    b.file(f"{doc}/Manuals/readme.txt", text("Device manuals"), 300)
    # A Git project (E7-01): committed on branch feature/search, then two files
    # changed and one added, so `git status` shows three changes.
    web = f"{doc}/Projects/web-app"
    committed = {
        "package.json": text('{ "name": "web-app" }'),
        "src/index.js": text("console.log('hello');"),
        "README.md": text("# web-app"),
        # The agent files (plant_agents) are committed too.
        "CLAUDE.md": WEB_CLAUDE_MD,
        ".mcp.json": WEB_MCP_JSON,
    }
    b.file(f"{web}/package.json", text('{ "name": "web-app", "private": true }'), 6)
    b.file(f"{web}/src/index.js", text("console.log('hello, search');"), 6)
    b.file(f"{web}/README.md", committed["README.md"], 6)
    b.file(f"{web}/TODO.md", text("- search results page"), 6)
    git_repo(b, web, committed, branch="feature/search", age_days=7)
    plant_agents(b)
    b.file(f"{doc}/Projects/old-site/package.json", text('{ "name": "old-site" }'), 250)
    b.file(f"{doc}/Projects/old-site/node_modules/left-pad/index.js", text("module.exports = 1;"), 250)
    b.file(f"{doc}/Projects/old-site/node_modules/left-pad/package.json", text('{ "name": "left-pad" }'), 250)
    b.sparse(f"{doc}/Projects/old-site/node_modules/.cache/build.bin", 380 * MIB, b"", 250)
    b.dir(f"{doc}/Projects/old-site", age_days=250)
    b.file(f"{doc}/Projects/api/Cargo.toml", text('[package]', 'name = "api"'), 10)
    b.file(f"{doc}/Projects/api/src/main.rs", text("fn main() {}"), 10)
    b.sparse(f"{doc}/Projects/api/target/debug/api", 400 * MIB, ELF_HEADER, 10, mode=0o755)
    b.file(f"{doc}/Notes.md", text("# Notes", "", "Ideas for the weekend."), 4)

    # --- Pictures, Videos, Desktop.
    for n in range(3):
        b.file(f"Pictures/Screenshots/Screenshot from 2026-10-0{n + 1} 10-00-00.png",
               png(40, 30, seed=70 + n), 30 - n)
    for n in range(5):
        b.file(f"Pictures/Holiday 2026/IMG_{4100 + n}.jpg", jpeg(f"holiday-{n}"), 100)
    b.sparse("Videos/Screencasts/Screencast from 2026-04-20 10-00-00.webm", 200 * MIB,
             WEBM_HEADER, 195, atime_days=195)
    b.sparse("Videos/Screencasts/Screencast from 2026-10-20 10-00-00.webm", 40 * MIB,
             WEBM_HEADER, 12)
    b.file("Desktop/todo.txt", text("Renew passport"), 3)

    # --- Developer caches and app leftovers (Smart Clean, Phase 5).
    dev_caches = {
        ".npm/_cacache/content-v2/blob.bin": 1100 * MIB,
        ".cache/pip/http/blob.bin": 640 * MIB,
        ".cargo/registry/cache/index/crates.bin": 420 * MIB,
        ".cache/go-build/blob.bin": 260 * MIB,
    }
    for rel, size in dev_caches.items():
        b.sparse(rel, size, b"", 20)
    b.sparse(".var/app/org.example.Removed/data/state.bin", 50 * MIB, b"", 120, atime_days=120)
    # Smart Clean (Phase 5): a Flatpak that is still installed (the tests' fake
    # `flatpak` lists it), a Snap that is not, a symlink inside a cache that
    # points at Documents (E5-06), and big folders called "cache" that are not
    # on the allow-list (E5-03): one hidden, one in plain sight.
    b.sparse(".var/app/org.example.Kept/data/state.bin", 20 * MIB, b"", 150, atime_days=150)
    b.sparse("snap/retired-tool/common/data.bin", 30 * MIB, b"", 130, atime_days=130)
    b.link(".npm/_cacache/docs", "../../Documents")
    b.sparse(".config/Studio/cache/blob.bin", 700 * MIB, b"", 15)
    for n in range(3):
        b.sparse(f"Documents/cache/part-{n + 1}.bin", 100 * MIB, f"part {n + 1}".encode(), 15)
    # Duplicates: a filed copy of a Downloads file (the Downloads one is spare),
    # and two filed copies (one is kept, the other is the user's call).
    b.file("Pictures/Backgrounds/wallpaper-4k.png", png(64, 36, seed=3), 2)
    b.file("Pictures/Favourites/IMG_4100.jpg", jpeg("holiday-0"), 60)

    manifest = describe(b)
    b.finish(manifest)
    return manifest


def describe(b: Builder) -> dict:
    files = b.files
    downloads_loose = sorted(rel for rel in files if rel.count("/") == 1 and rel.startswith("Downloads/"))
    partial = [rel for rel in downloads_loose if rel.endswith(PARTIAL_SUFFIXES)]
    tidyable = [rel for rel in downloads_loose if rel not in partial]
    by_kind: dict[str, list[str]] = {}
    for rel in tidyable:
        by_kind.setdefault(kind_of(rel), []).append(rel.split("/", 1)[1])

    groups: dict[str, list[str]] = {}
    for rel in sorted(files):
        if not files[rel]["sparse"]:
            digest = hashlib.sha256((b.root / rel).read_bytes()).hexdigest()
            groups.setdefault(digest, []).append(rel)
    duplicates = [paths for paths in groups.values() if len(paths) > 1]

    def folder(prefix: str) -> dict:
        inside = [rel for rel in files if rel.startswith(prefix + "/")]
        children = {rel[len(prefix) + 1:].split("/", 1)[0] for rel in inside}
        return {
            "items": len(children),
            "files": sum(1 for c in children if (prefix + "/" + c) in files),
            "dirs": sum(1 for c in children if (prefix + "/" + c) not in files),
            "tree_files": len(inside),
            "tree_bytes": sum(files[rel]["size"] for rel in inside),
        }

    named = ["Desktop", "Documents", "Downloads", "Pictures", "Videos",
             "Downloads/Receipts", "Downloads/Wallpapers", "Downloads/archive",
             "Documents/Invoices", "Documents/Manuals", "Documents/Clients",
             "Documents/Projects"]
    return {
        "recipe_version": RECIPE_VERSION,
        "now": datetime.fromtimestamp(NOW, timezone.utc).isoformat(),
        "kinds": {kind: sorted(exts) for kind, exts in KINDS.items()},
        "totals": {"files": len(files) + 1,  # + the marker itself
                   "bytes_apparent": sum(info["size"] for info in files.values())},
        "folders": {name: folder(name) for name in named},
        "downloads": {
            "loose_files": [rel.split("/", 1)[1] for rel in downloads_loose],
            "partial": [rel.split("/", 1)[1] for rel in partial],
            "by_kind": by_kind,
            "untouched_90_days": sorted(
                rel.split("/", 1)[1] for rel in tidyable
                if min(files[rel]["age_days"], files[rel]["atime_days"]) >= 90),
        },
        "tidy": {
            "moves": [{"from": rel, "to": f"Downloads/{kind_of(rel)}/{rel.split('/', 1)[1]}"}
                      for rel in tidyable],
            "left": [rel.split("/", 1)[1] for rel in partial],
        },
        "duplicates": duplicates,
        "dev_caches": {rel.split("/")[0] + "/" + rel.split("/")[1]: size
                       for rel, size in dev_caches_of(files).items()},
        "installers": {"Downloads/photo-tool_3.2.0_amd64.deb": {"package": "photo-tool",
                                                                 "version": "3.2.0"}},
        "clean": clean_cards(b, duplicates),
        "agents": agents_manifest(),
        "git": {"Documents/Projects/web-app": {"branch": "feature/search", "changes": 3,
                                                "changed": ["TODO.md", "package.json", "src/index.js"]}},
    }


# Smart Clean (DESIGN.md §4.3), as the tests' fake tools describe the system:
# photo-tool 3.2.0 is installed (dpkg), org.example.Kept is an installed
# Flatpak, and no Snap is installed. Each path belongs to the first card that
# finds it, in this order.
DEV_CACHES = (".npm/_cacache", ".cache/yarn", ".cache/pip", ".cargo/registry/cache",
              ".cache/go-build", ".gradle/caches", ".cache/ccache", ".ccache",
              ".cache/Homebrew/downloads")
BIG_FILE = 256 * MIB
COPY_NAME = re.compile(r"( \(\d+\)| copy( \d+)?)(\.[^./]+)?$|^Copy of ", re.IGNORECASE)


def clean_cards(b: Builder, duplicates: list[list[str]]) -> dict:
    files = b.files

    def under(prefix: str) -> list[str]:
        return [rel for rel in files if rel.startswith(prefix + "/")]

    def visible(rel: str) -> bool:
        return not any(part.startswith(".") for part in rel.split("/"))

    def age(rel: str) -> float:
        return files[rel]["age_days"]

    cards: dict[str, list[dict]] = {}
    cards["dev_caches"] = [
        {"path": c, "bytes": sum(files[r]["size"] for r in under(c)), "ticked": True}
        for c in DEV_CACHES if under(c)]

    dupes = []
    for group in duplicates:
        group = [rel for rel in group if visible(rel)]
        if len(group) < 2:
            continue
        loose = lambda rel: rel.split("/", 1)[0] in ("Downloads", "Desktop")  # noqa: E731
        copy_like = lambda rel: bool(COPY_NAME.search(rel.rsplit("/", 1)[-1]))  # noqa: E731
        keep = min(group, key=lambda rel: (loose(rel), copy_like(rel), -age(rel), len(rel), rel))
        for rel in sorted(group):
            dupes.append({"path": rel, "bytes": files[rel]["size"], "keep": rel == keep,
                          "ticked": rel != keep and (loose(rel) or copy_like(rel))})
    cards["duplicates"] = dupes

    cards["installers"] = [{"path": "Downloads/photo-tool_3.2.0_amd64.deb",
                            "bytes": files["Downloads/photo-tool_3.2.0_amd64.deb"]["size"],
                            "ticked": True}]
    stale = "Documents/Projects/old-site/node_modules"
    cards["stale_builds"] = [{"path": stale, "bytes": sum(files[r]["size"] for r in under(stale)),
                              "ticked": False}]
    cards["leftovers"] = [{"path": p, "bytes": sum(files[r]["size"] for r in under(p)), "ticked": False}
                          for p in (".var/app/org.example.Removed", "snap/retired-tool")]
    claimed = {i["path"] for card in cards.values() for i in card}

    def free(rel: str) -> bool:
        return not any(rel == c or rel.startswith(c + "/") for c in claimed)

    big = sorted((rel for rel in files if visible(rel) and files[rel]["size"] >= BIG_FILE
                  and not rel.endswith(PARTIAL_SUFFIXES) and free(rel)),
                 key=lambda rel: (-files[rel]["size"], rel))
    cards["big_files"] = [{"path": rel, "bytes": files[rel]["size"], "ticked": False} for rel in big]
    claimed |= set(big)
    cards["screencasts"] = [{"path": rel, "bytes": files[rel]["size"], "ticked": False}
                            for rel in sorted(under("Videos/Screencasts")) if age(rel) >= 90 and free(rel)]
    claimed |= {i["path"] for i in cards["screencasts"]}
    old = [rel for rel in sorted(files) if rel.count("/") == 1 and rel.startswith("Downloads/")
           and not rel.endswith(PARTIAL_SUFFIXES)
           and min(files[rel]["age_days"], files[rel]["atime_days"]) >= 90 and free(rel)]
    cards["old_downloads"] = [{"path": rel, "bytes": files[rel]["size"], "ticked": False} for rel in old]

    totals = {card: sum(i["bytes"] for i in items if not i.get("keep")) for card, items in cards.items()}
    ticked = sum(i["bytes"] for items in cards.values() for i in items if i["ticked"])
    return {"cards": cards, "totals": totals, "ticked_bytes": ticked,
            "not_listed": [".config/Studio/cache", "Documents/cache"],
            "cache_symlink": {"path": ".npm/_cacache/docs", "target": "../../Documents"}}


def dev_caches_of(files: dict) -> dict:
    prefixes = (".npm/", ".cache/pip/", ".cargo/registry/", ".cache/go-build/")
    return {rel: info["size"] for rel, info in files.items() if rel.startswith(prefixes)}


# -------------------------------------------------------------- utilities ---


def digest(root: Path) -> str:
    """A digest of the tree: names, types, modes, sizes, times and contents.

    Files over 16 MiB contribute their size and first MiB only, so sparse
    "gigabyte" files do not have to be read in full."""
    hasher = hashlib.sha256()
    for path in sorted(root.rglob("*")):
        st = path.lstat()
        rel = path.relative_to(root).as_posix()
        kind = "l" if path.is_symlink() else ("d" if path.is_dir() else "f")
        if kind == "l":
            hasher.update(f"{rel}\0l\0{os.readlink(path)}\0".encode())
            continue
        hasher.update(f"{rel}\0{kind}\0{st.st_mode & 0o7777:o}\0{st.st_mtime_ns}\0".encode())
        if kind == "f":
            hasher.update(f"{st.st_size}\0".encode())
            with open(path, "rb") as handle:
                hasher.update(handle.read(MIB if st.st_size > 16 * MIB else st.st_size))
    return hasher.hexdigest()


def prepare(dest: Path, force: bool) -> None:
    """Makes `dest` empty, but only if it is already a fixture home, empty, or a
    freshly created user skeleton. Refuses anything else: this never clears a
    real home folder."""
    dest.mkdir(parents=True, exist_ok=True)
    entries = list(dest.iterdir())
    if not entries:
        return
    names = {entry.name for entry in entries}
    clearable = (dest / MARKER).is_file() or names <= SKELETON_FILES
    if not force or not clearable:
        reason = "it is not empty" if not force else "it is not a fixture home"
        sys.exit(f"make-fixture-home: refusing to use {dest}: {reason}.")
    for entry in entries:
        if entry.is_dir() and not entry.is_symlink():
            shutil.rmtree(entry)
        else:
            entry.unlink()


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("dest", type=Path)
    parser.add_argument("--force", action="store_true",
                        help="clear DEST first (only if it is already a fixture home)")
    parser.add_argument("--digest", action="store_true", help="print the digest of DEST and exit")
    args = parser.parse_args()
    if args.digest:
        print(digest(args.dest))
        return
    prepare(args.dest, args.force)
    manifest = build(args.dest)
    print(f"fixture home ready: {args.dest} ({manifest['totals']['files']} files, "
          f"recipe {RECIPE_VERSION})")


if __name__ == "__main__":
    main()
