<RCC>
  <!-- Qt 6.4 (Ubuntu 24.04): a file's implicit import of its own folder wins
       over the module, and without this qmldir Theme.qml is a plain type
       there, not the singleton. Qt 6.5+ resolves it through the module; this
       file changes nothing there. -->
  <qresource prefix="/qt/qml/dev/steward/files/qml">
    <file alias="qmldir">qmldir.local</file>
  </qresource>
</RCC>
